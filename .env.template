# Copy this file to .env and fill in the values.
#
#   cp .env.template .env
#
# .env is git-ignored. Never commit real credentials.
# Every variable without a documented default is required — the processor refuses to
# start if one is missing.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# "development" or "production". Defaults to "development".
NODE_ENV="development"

# Pino log level: trace | debug | info | warn | error | fatal. Defaults to "info".
LOG_LEVEL="info"

# Origin allowed by the WebSocket server on port 3002, e.g. "https://example.com".
# Leave empty in development to accept any origin. Set it in production.
CORS_ORIGIN=""

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Postgres connection string. This is the SAME database tokenzyme-core reads from:
# the indexer writes the on-chain tables (accounts, tokens, trades, social_media,
# dex_liquidities) into the "public" schema, and core reads them from there while
# owning its own tables under the "tokenzyme" schema.
#
# Note there is no "?schema=" here — TypeORM writes to "public".
DB_URL="postgresql://postgres:postgres@localhost:5432/tokenzyme"

# ---------------------------------------------------------------------------
# Indexing
# ---------------------------------------------------------------------------

# Maximum RPC requests per second. Keep this under your provider's limit —
# public endpoints throttle aggressively.
RPC_RATE_LIMIT="10"

# Blocks to wait before treating a block as final. Sonic finalizes quickly;
# raise this on chains with deeper reorgs.
FINALITY_CONFIRMATION="10"

# Block to start indexing from. Use the block the launchpad proxy was deployed in —
# starting from 0 wastes hours scanning empty history.
FROM_BLOCK="0"

# ---------------------------------------------------------------------------
# Blockchain
# ---------------------------------------------------------------------------
# NETWORK, RPC_URL and LAUNCHPAD_ADDRESS must all describe the same network, and must
# match what tokenzyme-core and the clients are pointed at. Uncomment one block.
#
# On "mainnet" and "testnet" the processor also uses the Subsquid archive gateway,
# which is far faster than replaying history over RPC. "fork" and "testnet-legacy"
# index over RPC only.

# Local fork (chain ID 1337) — run `yarn test:fork:startNode` in tokenzyme-contracts
# NETWORK="fork"
# RPC_URL="http://127.0.0.1:8545"
# LAUNCHPAD_ADDRESS=""

# Sonic mainnet (chain ID 146)
# NETWORK="mainnet"
# RPC_URL="https://rpc.soniclabs.com"
# LAUNCHPAD_ADDRESS="0x9E23D1354E30C2274D3f0Ae2D70c9324081A6E4c"

# Sonic testnet (chain ID 14601)
# NETWORK="testnet"
# RPC_URL="https://rpc.testnet.soniclabs.com"
# LAUNCHPAD_ADDRESS="0xcafD49ea48EFa63e94a8392Bb78924Ed1a26e702"

# Sonic Blaze testnet (chain ID 57054, legacy)
# NETWORK="testnet-legacy"
# RPC_URL="https://rpc.blaze.soniclabs.com"
# LAUNCHPAD_ADDRESS="0x9E23D1354E30C2274D3f0Ae2D70c9324081A6E4c"
